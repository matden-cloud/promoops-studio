# URL deployment Web App Apps Script yang baru (berakhiran /exec).
APPS_SCRIPT_URL=

# Rahasia yang sama dengan Script Property APPS_SCRIPT_TOKEN di Apps Script.
APPS_SCRIPT_TOKEN=

# Kunci Gemini. Hanya dibaca server saat fungsi /api berjalan.
# Dipakai /api/gemini dan /api/voice. Jangan memakai awalan yang masuk ke bundle browser.
GEMINI_API_KEY=

# Fish Audio. Hanya model s2.1-pro-free. Mesin mati 1 Des 2026 00.00 WIB.
FISH_API_KEY=

# Inworld. Hanya model inworld-tts-2-flash. Batas 65 menit dihitung di browser.
INWORLD_API_KEY=

# Opsional. Kosongkan untuk memakai gemini-3.5-flash-lite.
# Hanya huruf, angka, titik, dan minus, misalnya gemini-2.5-flash.
GEMINI_MODEL=

# Application (client) ID aplikasi Microsoft publik. Bukan client secret.
# Login memakai https://login.microsoftonline.com/common
ONEDRIVE_CLIENT_ID=

# Kunci API Repliz. Hanya dibaca server saat /api/repliz-* berjalan.
REPLIZ_ACCESS_KEY=
REPLIZ_SECRET_KEY=

# Rahasia HMAC untuk URL media OneDrive yang diambil Repliz. Minimal 16 karakter.
# Jangan dikosongkan di produksi: server menolak URL tanpa tanda tangan.
MEDIA_URL_SECRET=

# Opsional. Origin publik aplikasi, misalnya https://promoops.example.com
# Kosongkan untuk memakai VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_APP_URL=
