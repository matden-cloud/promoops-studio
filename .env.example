# URL deployment Web App Apps Script yang baru (berakhiran /exec).
APPS_SCRIPT_URL=

# Rahasia yang sama dengan Script Property APPS_SCRIPT_TOKEN di Apps Script.
APPS_SCRIPT_TOKEN=

# Kunci Gemini. Hanya dibaca server saat fungsi /api berjalan.
# Jangan memakai awalan yang membuat Vite menyisipkan nilai ini ke bundle browser.
GEMINI_API_KEY=
